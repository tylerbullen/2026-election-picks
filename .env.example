# Added automatically when you connect Upstash Redis in Vercel (either pair works)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Your secret for entering results: open https://<your-site>/?admin=<ADMIN_KEY>
ADMIN_KEY=
# Optional: picks can't be changed after this time (ISO 8601). 6 pm ET Election Day:
PICKS_LOCK_AT=2026-11-03T23:00:00Z
